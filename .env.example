# Copia este archivo como .env y agrega tus claves. Sin claves, la app usa datos de demostración.

# Google Maps Platform: habilita "Maps JavaScript API" y "Places API (New)".
# Con clave: negocios parecidos reales y fichas con fotos, horario y reseñas.
# Sin clave: la vista Google Maps, Street View y los enlaces siguen funcionando.
# Restringe la clave por referrer HTTP (p. ej. http://localhost:5173/*).
VITE_GOOGLE_MAPS_API_KEY=

# TomTom Developer: Traffic API (flujo en vivo y capa de tráfico).
VITE_TOMTOM_API_KEY=
